.profile-pic-container {
  grid-column: 1 / -1;
  text-align: center;
  border: 2px dashed var(--border);
  padding: 2rem;
  border-radius: var(--radius);
  margin-bottom: 1rem;
  min-height: 150px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  position: relative;
  transition: all 0.3s ease;
}

/* Show "Change Photo" text when image is present */
.profile-pic-container.has-image .custom-file-upload::after {
  content: "Change Photo";
  display: block;
  margin-top: 0.5rem;
  font-size: 0.8rem;
  color: white;
  background: rgba(0,0,0,0.5);
  padding: 0.2rem 0.5rem;
  border-radius: 4px;
}

input[type="file"] {
  display: none;
}

.custom-file-upload {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  background: var(--primary);
  color: white;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.2s ease;
}

.custom-file-upload:hover {
  background: var(--primary-hover);
}

.save-btn {
  grid-column: 1 / -1;
  background: var(--primary);
  color: white;
  padding: 1rem 2rem;
  border: none;
  border-radius: 8px;
  font-size: 1.1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-top: 1rem;
}

.save-btn:hover {
  background: var(--primary-hover);
  transform: translateY(-1px);
}

footer {
  text-align: center;
  margin-top: 3rem;
  color: #64748b;
  font-size: 0.9rem;
}

/* Error handling */
.errorlist {
  list-style: none;
  color: #dc2626;
  font-size: 0.85rem;
  margin-top: 0.25rem;
}

input:invalid, select:invalid, textarea:invalid {
  border-color: #f87171;
}

/* Responsive Design */
@media (max-width: 768px) {
  body {
    padding: 1rem;
  }
  
  .edit-container {
    padding: 1.5rem;
  }
  
  header h1 {
    font-size: 2rem;
  }
}

@media (max-width: 480px) {
  form {
    grid-template-columns: 1fr;
  }
  
  .save-btn {
    width: 100%;
  }
}
